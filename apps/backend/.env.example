# ==============================================================================
# ANALYTICS INTELLIGENCE SAAS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` and fill in your local credentials.
# NEVER commit your `.env` file or paste passwords in chat.
# ==============================================================================

# Application URL
APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Local PostgreSQL Database (Prisma 7)
# Standard format: postgresql://<USER>:<PASSWORD>@localhost:5432/<DATABASE_NAME>?schema=public
# Example: postgresql://postgres:mypassword@localhost:5432/analytics_saas?schema=public
DATABASE_URL="postgresql://postgres:your_local_password@localhost:5432/analytics_saas?schema=public"

# Auth.js / NextAuth v5 Secret
# Generate a secure 32-byte secret using: openssl rand -base64 32 or node -e "console.log(crypto.randomBytes(32).toString('hex'))"
AUTH_SECRET="your_generated_auth_secret_here"

# Google Sign-In (For user SaaS authentication only, optional during initial local testing)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Token Encryption Master Key (AES-256-GCM - for future GA4 OAuth token encryption)
ENCRYPTION_MASTER_KEY="your_generated_32_byte_hex_encryption_key_here"

# Email Delivery Configuration (Local test mode by default)
# Supported modes: "mock" (logs to server console/test runner) | "smtp"
EMAIL_PROVIDER="mock"
EMAIL_FROM="noreply@analytics-saas.local"

# Future AI / Gemini Integration
GEMINI_API_KEY=""
